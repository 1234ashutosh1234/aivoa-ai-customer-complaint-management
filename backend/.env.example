# Environment Settings
ENVIRONMENT=development
DEBUG=True

# Database Configuration (PostgreSQL primary architecture; leave empty or sqlite for default development fallback)
# Production Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# Groq Cloud LLM Configuration
# Assignment requested model: gemma2-9b-it (decommissioned upstream by Groq)
# Verified active runtime model: openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ASSIGNMENT_REQUESTED_MODEL=gemma2-9b-it
CONTEXTUAL_MODEL=openai/gpt-oss-120b

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Server Bind Settings
APP_HOST=127.0.0.1
APP_PORT=8000
